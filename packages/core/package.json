  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm build && publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "file-type": "catalog:",
    "image-size": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  }
}
