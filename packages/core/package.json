{
  "name": "@imgrelay/core",
  "version": "0.0.0",
  "private": true,
  "description": "ImgRelay 配置、凭据和 OpenAI Images 调用核心",
  "homepage": "https://github.com/bingwu-devkit/imgrelay#readme",
  "bugs": "https://github.com/bingwu-devkit/imgrelay/issues",
  "license": "MIT",
  "author": "BINGWU2003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingwu-devkit/imgrelay.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
