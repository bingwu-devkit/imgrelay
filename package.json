{
  "name": "imgrelay-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "通过统一 CLI 和 Codex Skill 调用多家生图中转站",
  "homepage": "https://github.com/bingwu-devkit/imgrelay#readme",
  "bugs": "https://github.com/bingwu-devkit/imgrelay/issues",
  "license": "MIT",
  "author": "BINGWU2003",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingwu-devkit/imgrelay.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm build && pnpm lint && turbo run typecheck test",
    "dev": "turbo run dev",
    "format": "oxfmt -c oxfmt.config.ts --disable-nested-config . --write",
    "format:check": "oxfmt -c oxfmt.config.ts --disable-nested-config . --check",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix",
    "prepare": "simple-git-hooks",
    "release": "pnpm build && changeset publish",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "nano-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0",
    "pnpm": "11.15.1"
  },
  "packageManager": "pnpm@11.15.1"
}
